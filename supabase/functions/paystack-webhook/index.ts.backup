    // Record payment
    const { error: paymentError } = await supabase
        .from('payments')
        .insert({
            user_id: customStr2,
            payment_id: paymentId,
            amount: amount,
            currency: 'ZAR',
            status: 'completed',
            payment_method: 'payfast',
            payment_type: paymentType,
            reference_id: paymentType === 'bill_payment' ? customStr1 : null,
            metadata: {
                processed_at: new Date().toISOString(),
            }
        })

    if (paymentError) {
        console.error('Payment recording error:', paymentError)
        throw paymentError
    }

    if (paymentType === 'subscription') {
        // Update subscription
        const { error: subscriptionError } = await supabase
            .from('subscriptions')
            .insert({
                user_id: customStr2,
                plan_name: 'Premium Monthly',
                status: 'active',
                payment_method: 'payfast',
                auto_renew: true,
                amount: amount,
                currency: 'ZAR',
                start_date: new Date().toISOString(),
                end_date: new Date(Date.now() + 30 * 24 * 60 * 60 * 1000).toISOString(),
            })

        if (subscriptionError) {
            console.error('Subscription update error:', subscriptionError)
            throw subscriptionError
        }
    } else if (paymentType === 'bill_payment') {
        // Update bill payment status
        const { error: billError } = await supabase
            .from('processed_bills')
            .update({
                payment_method: 'in_app',
                payment_id: paymentId,
                payment_status: 'paid',
                paid_at: new Date().toISOString(),
            })
            .eq('id', customStr1)

        if (billError) {
            console.error('Bill update error:', billError)
            throw billError
        }
    }
}

async function handleFailedPayment(supabase, { paymentId, customStr1, customStr2 }) {
    const { error } = await supabase
        .from('payments')
        .insert({
            user_id: customStr2,
            payment_id: paymentId,
            amount: 0.0,
            currency: 'ZAR',
            status: 'failed',
            payment_method: 'payfast',
            metadata: {
                failure_reason: 'Payment failed',
                processed_at: new Date().toISOString(),
            }
        })

    if (error) {
        console.error('Failed payment recording error:', error)
        throw error
    }
}

async function handleCancelledPayment(supabase, { paymentId, customStr1, customStr2 }) {
    const { error } = await supabase
        .from('payments')
        .insert({
            user_id: customStr2,
            payment_id: paymentId,
            amount: 0.0,
            currency: 'ZAR',
            status: 'cancelled',
            payment_method: 'payfast',
            metadata: {
                cancel_reason: 'Payment cancelled by user',
                processed_at: new Date().toISOString(),
            }
        })

    if (error) {
        console.error('Cancelled payment recording error:', error)
        throw error
    }
}