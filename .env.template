# IMPORTANT: This file is a template. DO NOT commit live secret keys to source control.
# Use placeholders here and keep real secrets in your local `.env` (ignored by git)
# or set them as project/function secrets in Supabase (recommended for server-side keys).

# Paystack Configuration (placeholders only)
# For client-side/public values (safe to include in local .env):
PAYSTACK_PUBLIC_KEY=pk_live_your_public_key_here
PAYSTACK_SANDBOX=false

# Enable only after activating Google Pay AND Card in Paystack Payments settings.
# Android checkout screens offer a browser option; the existing card flow remains.
PAYSTACK_GOOGLE_PAY_ENABLED=false

# For server-side secret keys DO NOT place live secrets in this template.
# Set `PAYSTACK_SECRET_KEY` as a Supabase Edge Function secret:
#   supabase secrets set PAYSTACK_SECRET_KEY=sk_live_your_secret_here
# The secret key is NEVER included in .env (it must not ship in the APK).
# All secret-key Paystack calls are proxied through the paystack-proxy Edge Function.

# Paystack Subscription Plan Codes (create plans in Paystack dashboard first)
PAYSTACK_MONTHLY_PLAN_CODE=PLN_your_monthly_plan_code_here
# PAYSTACK_ANNUAL_PLAN_CODE=PLN_your_annual_plan_code_here  # Optional for future use

# Set to 'true' for local testing (skips real Paystack), 'false' for production
PAYSTACK_DEVELOPMENT_MODE=false

# Callback URL for payment success redirect (configure same in Paystack dashboard)
PAYSTACK_CALLBACK_URL=locallekker://payment/callback

# Optional: public HTTPS URL for the Local Lekker logo used on Paystack's
# hosted checkout page. The image must be publicly reachable by Paystack.
PAYSTACK_LOGO_URL=https://your-public-logo-url-here.png

# Supabase Configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here

# Google Sign-In (Web/OAuth client ID — used as the audience for native ID tokens too)
# Create in Google Cloud Console > APIs & Services > Credentials, and enable the
# same Google provider + Client ID in Supabase Dashboard > Authentication > Providers.
GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# Google Maps API Configuration (if used)
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY

# Production Navigation
FORCE_WELCOME_PAGE=false

# Veryfi OCR API Configuration (if used)
VERYFI_CLIENT_ID=YOUR_CLIENT_ID
VERYFI_CLIENT_SECRET=YOUR_CLIENT_SECRET
VERYFI_USERNAME=YOUR_USERNAME
VERYFI_API_KEY=YOUR_API_KEY
